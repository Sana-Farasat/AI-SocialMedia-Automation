# ============================================================
# SocialPilot AI — Backend Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit real credentials.
# ============================================================

# --- App ---
APP_NAME=SocialPilot AI
APP_ENV=development            # development | production
DEBUG=true
API_PREFIX=/api
# Strong secret for signing JWT/cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (Neon PostgreSQL) ---
# Use your Neon connection string here. Add ?sslmode=require for Neon.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/socialpilot_ai?sslmode=require
# Local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- CORS ---
FRONTEND_URLS=["http://localhost:3000"]
BACKEND_URL=http://localhost:8000

# --- AI (OpenAI Agents SDK -> Gemini OpenAI-compatible endpoint) ---
# Use your free Gemini API key here.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash

# --- Redis (queue/worker state; optional in simple deploys) ---
REDIS_URL=redis://localhost:6379/0

# --- Worker trigger (external cron, e.g. cron-job.org) ---
# Used to authenticate GET /api/worker/process-due. Set a separate token so
# SECRET_KEY never appears in scheduler URLs. Falls back to SECRET_KEY if empty.
WORKER_TOKEN=

# --- OAuth: Meta (Facebook / Instagram / Threads) ---
META_CLIENT_ID=
META_CLIENT_SECRET=

# --- OAuth: LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- OAuth: X / Twitter ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- OAuth: Pinterest ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- OAuth: TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- OAuth: YouTube (Google) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Object storage (media) ---
# local | cloudinary | s3 | supabase
STORAGE_PROVIDER=local

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Supabase Storage
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Email (verification / password reset architecture) ---
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
